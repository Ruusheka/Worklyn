# Worklyn Frontend Environment Configuration
# Copy this file to .env.local for local development. Never commit .env.local to version control.

# API base URL - in development, Vite proxies /api → backend:8080
# In Docker mode, Nginx handles routing so this can remain /api/v1
VITE_API_BASE_URL=/api/v1

# Set to 'true' to force mock service responses even when backend is reachable (testing only)
VITE_USE_MOCK=false
