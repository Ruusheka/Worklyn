    {
      "name": "05-Payroll",
      "item": [
        {
          "name": "Run Monthly Payroll (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Payroll records processed\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.period).to.eql(pm.environment.get(\"period\"));",
                  "    pm.expect(data.processedCount).to.be.at.least(1);",
                  "    pm.expect(data.records).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "payroll-run-{{period}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"period\": \"{{period}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll/process",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll",
                "process"
              ]
            }
          }
        },
        {
          "name": "View Period Payroll Records",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Returns records for current period\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    pm.expect(data.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll/period/{{period}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll",
                "period",
                "{{period}}"
              ]
            }
          }
        },
        {
          "name": "View Employee Payslip",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Payslip contains gross and net pay breakdown\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.employeeId).to.eql(pm.environment.get(\"employeeId\"));",
                  "    pm.expect(data.payrollPeriod).to.eql(pm.environment.get(\"period\"));",
                  "    pm.expect(data.grossPay).to.be.at.least(0);",
                  "    pm.expect(data.netPay).to.be.at.least(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payroll/payslip/{{employeeId}}?period={{period}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payroll",
                "payslip",
                "{{employeeId}}"
              ],
              "query": [
                {
                  "key": "period",
                  "value": "{{period}}"
                }
              ]
            }
          }
        },
        {
          "name": "Finalize Payroll Period (HR/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Period finalized message returned\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.message).to.include(\"finalized\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
