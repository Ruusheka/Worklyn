{
  "info": {
    "_postman_id": "worklyn-person-2-collection",
    "name": "Worklyn Person 2 Collection (Attendance, Leave, Payroll)",
    "description": "Ready-to-run Postman collection for Worklyn Person 2 modules: Attendance, Leave Management, and Payroll.",
