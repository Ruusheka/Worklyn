  "item": [
    {
      "name": "03-Attendance",
      "item": [
        {
          "name": "Check-In (Idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "pm.test(\"Attendance record created with valid status\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.employeeId).to.eql(pm.environment.get(\"employeeId\"));",
                  "    pm.expect(data.status).to.be.oneOf([\"PRESENT\", \"LATE\"]);",
                  "    pm.expect(data.idempotencyKey).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"2026-10-24T09:15:00Z\",\n  \"idempotencyKey\": \"checkin-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "check-in"
              ]
            }
          }
        },
        {
          "name": "Check-Out",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Check-out updates duration\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.checkOutTime).to.not.be.null;",
                  "    pm.expect(data.workDurationMinutes).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"2026-10-24T18:00:00Z\",\n  \"idempotencyKey\": \"checkout-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/check-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "check-out"
              ]
            }
          }
        },
        {
          "name": "My Attendance History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Returns paged attendance records\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.content).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/my-history?startDate=2026-10-01&endDate=2026-10-31&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "my-history"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-10-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-10-31"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Employee Attendance History (Admin/HR/Manager)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"Returns paged employee attendance list\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.content).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/employee/{{employeeId}}?startDate=2026-10-01&endDate=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "employee",
                "{{employeeId}}"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-10-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        }
      ]
