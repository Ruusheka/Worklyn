        {
          "name": "Apply for Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "pm.test(\"Leave application is PENDING\", function () {",
                  "    pm.expect(data.status).to.eql(\"PENDING\");",
                  "    pm.expect(data.totalDays).to.be.above(0);",
                  "});",
                  "",
                  "if (data.id) {",
                  "    pm.collectionVariables.set(\"leaveId\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"CASUAL\",\n  \"startDate\": \"2026-11-02\",\n  \"endDate\": \"2026-11-04\",\n  \"reason\": \"Personal family commitment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/leaves/apply",
              "host": [
